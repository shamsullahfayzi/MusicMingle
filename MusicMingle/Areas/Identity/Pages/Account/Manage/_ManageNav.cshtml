@inject SignInManager<IdentityUser> SignInManager
@{
    var hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
}

<div class="bg-white/90 backdrop-blur-sm rounded-2xl shadow-lg p-6">
    <div class="space-y-1">
        <!-- Profile -->
        <a class="@ManageNavPages.IndexNavClass(ViewContext) group flex items-center px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200"
           id="profile" asp-page="./Index">
            <span class="mr-3 flex-shrink-0 h-6 w-6 text-purple-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </span>
            Profile
            <span class="ml-auto bg-purple-100 text-purple-800 text-xs font-medium px-2.5 py-0.5 rounded-full hidden group-[.active]:inline-flex">
                Current
            </span>
        </a>

        <!-- Email -->
        <a class="@ManageNavPages.EmailNavClass(ViewContext) group flex items-center px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200"
           id="email" asp-page="./Email">
            <span class="mr-3 flex-shrink-0 h-6 w-6 text-pink-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
            </span>
            Email
            <span class="ml-auto bg-pink-100 text-pink-800 text-xs font-medium px-2.5 py-0.5 rounded-full hidden group-[.active]:inline-flex">
                Current
            </span>
        </a>

        <!-- Password -->
        <a class="@ManageNavPages.ChangePasswordNavClass(ViewContext) group flex items-center px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200"
           id="change-password" asp-page="./ChangePassword">
            <span class="mr-3 flex-shrink-0 h-6 w-6 text-blue-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
            </span>
            Password
            <span class="ml-auto bg-blue-100 text-blue-800 text-xs font-medium px-2.5 py-0.5 rounded-full hidden group-[.active]:inline-flex">
                Current
            </span>
        </a>

        <!-- External Logins -->
        @if (hasExternalLogins)
        {
            <a class="@ManageNavPages.ExternalLoginsNavClass(ViewContext) group flex items-center px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200"
               id="external-login" asp-page="./ExternalLogins">
                <span class="mr-3 flex-shrink-0 h-6 w-6 text-indigo-500">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
                    </svg>
                </span>
                External logins
                <span class="ml-auto bg-indigo-100 text-indigo-800 text-xs font-medium px-2.5 py-0.5 rounded-full hidden group-[.active]:inline-flex">
                    Current
                </span>
            </a>
        }

        <!-- Two-Factor Auth -->
        <a class="@ManageNavPages.TwoFactorAuthenticationNavClass(ViewContext) group flex items-center px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200"
           id="two-factor" asp-page="./TwoFactorAuthentication">
            <span class="mr-3 flex-shrink-0 h-6 w-6 text-yellow-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                </svg>
            </span>
            Two-factor authentication
            <span class="ml-auto bg-yellow-100 text-yellow-800 text-xs font-medium px-2.5 py-0.5 rounded-full hidden group-[.active]:inline-flex">
                Current
            </span>
        </a>

        <!-- Personal Data -->
        <a class="@ManageNavPages.PersonalDataNavClass(ViewContext) group flex items-center px-4 py-3 text-sm font-medium rounded-xl transition-all duration-200"
           id="personal-data" asp-page="./PersonalData">
            <span class="mr-3 flex-shrink-0 h-6 w-6 text-green-500">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
            </span>
            Personal data
            <span class="ml-auto bg-green-100 text-green-800 text-xs font-medium px-2.5 py-0.5 rounded-full hidden group-[.active]:inline-flex">
                Current
            </span>
        </a>
    </div>
</div>

<style>
    .nav-link {
    @@apply text-gray-600 hover:text-purple-700 hover:bg-purple-50;
    }

        .nav-link.active {
   @@apply text-purple-700 bg-purple-50;
        }

    .group {
    @@apply hover: bg-gray-50 hover:text-purple-600;
    }

        .group.active {
    @@apply bg-purple-50 text-purple-600 font-semibold;
        }
</style>