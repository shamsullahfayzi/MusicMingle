@page
@model MusicMingle.Pages.Events.IndexModel
@{
    ViewData["Title"] = "Events";
}

<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
        <h1 class="text-4xl font-bold mb-8 text-center text-gray-800">Upcoming Events</h1>

        <!-- Search and Filter Form -->
        <form method="get" class="mb-8 bg-white p-6 rounded-lg shadow-md border border-gray-200">
            <div class="flex flex-wrap items-center gap-4">
                <div class="flex-grow">
                    <label for="SearchString" class="sr-only">Search Events</label>
                    <input type="text" asp-for="SearchString" id="SearchString" placeholder="Search by title or description..." class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500" />
                </div>
                <div class="flex-grow md:flex-grow-0">
                    <label for="SelectedCategoryId" class="sr-only">Filter by Category</label>
                    <select asp-for="SelectedCategoryId" asp-items="Model.Categories" id="SelectedCategoryId" class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500">
                        <option value="">All Categories</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="bg-purple-600 text-white font-bold py-2 px-6 rounded-md hover:bg-purple-700 transition duration-150 ease-in-out">Filter</button>
                </div>
            </div>
        </form>

        <!-- Event Listing -->
        @if (Model.Events != null && Model.Events.Any())
        {
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var item in Model.Events)
                {
                    <div class="max-w-sm bg-white border border-gray-200 rounded-lg shadow dark:bg-gray-800 dark:border-gray-700 overflow-hidden flex flex-col">
                        <a asp-page="./Details" asp-route-id="@item.Id">
                            @if (!string.IsNullOrEmpty(item.ThumbnailImagePath))
                            {
                                <img class="rounded-t-lg object-cover h-48 w-full" src="@item.ThumbnailImagePath" alt="@item.Title event image" />
                            }
                            else
                            {
                                <div class="rounded-t-lg h-48 w-full bg-gradient-to-r from-purple-400 via-pink-400 to-blue-400 flex items-center justify-center">
                                    <span class="text-white text-lg font-semibold">No Image</span>
                                </div>
                            }
                        </a>
                        <div class="p-5 flex flex-col flex-grow">
                            <a asp-page="./Details" asp-route-id="@item.Id">
                                <h5 class="mb-2 text-2xl font-bold tracking-tight text-gray-900 dark:text-white hover:text-purple-700">@Html.DisplayFor(modelItem => item.Title)</h5>
                            </a>
                            <p class="mb-1 text-sm text-gray-500 dark:text-gray-400">@Html.DisplayFor(modelItem => item.Category.Name)</p>
                            <p class="mb-3 font-normal text-gray-700 dark:text-gray-400 flex-grow">@Html.DisplayFor(modelItem => item.Description)</p>
                            <p class="mb-3 font-semibold text-gray-800 dark:text-gray-200">@item.StartDateTime.ToString("g")</p>
                            <div class="mt-auto">
                                 <a asp-page="./Details" asp-route-id="@item.Id" class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-purple-600 rounded-lg hover:bg-purple-700 focus:ring-4 focus:outline-none focus:ring-purple-300 dark:bg-purple-500 dark:hover:bg-purple-600 dark:focus:ring-purple-800">
                                    View Details
                                    <svg class="rtl:rotate-180 w-3.5 h-3.5 ms-2" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
                                        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
                                    </svg>
                                </a>
                                @if (User.IsInRole("Admin"))
                                {
                                    <a asp-page="./Edit" asp-route-id="@item.Id" class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-gray-700 bg-gray-200 rounded-lg hover:bg-gray-300 focus:ring-4 focus:outline-none focus:ring-gray-100 dark:bg-gray-600 dark:text-gray-300 dark:hover:bg-gray-500 dark:focus:ring-gray-700 ms-2">Edit</a>
                                    <a asp-page="./Delete" asp-route-id="@item.Id" class="inline-flex items-center px-3 py-2 text-sm font-medium text-center text-white bg-red-600 rounded-lg hover:bg-red-700 focus:ring-4 focus:outline-none focus:ring-red-300 dark:bg-red-500 dark:hover:bg-red-600 dark:focus:ring-red-800 ms-2">Delete</a>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-10">
                <p class="text-xl text-gray-600">No events found matching your criteria. Try adjusting your search or filter!</p>
            </div>
        }
    </div>
</section>