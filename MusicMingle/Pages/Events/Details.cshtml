@page "{id:int}"
@model MusicMingle.Pages.Events.DetailsModel
@{
    ViewData["Title"] = Model.Event?.Title ?? "Event Details";
}

<section class="py-12 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4">
        @if (Model.Event != null)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
                <div class="flex justify-center">
                    @if (!string.IsNullOrEmpty(Model.Event.ThumbnailImagePath))
                    {
                        <img src="@Url.Content(Model.Event.ThumbnailImagePath)" alt="@Model.Event.Title"
                             class="rounded-lg shadow-md w-full object-cover max-h-[400px]">
                    }
                </div>

                <div class="flex flex-col">
                    <h1 class="text-3xl md:text-4xl font-bold text-gray-800 mb-4">@Model.Event.Title</h1>

                    <p class="text-gray-600 mb-2">
                        <i class="bi bi-calendar-event"></i>
                        @Model.Event.StartDateTime.ToString("MMMM dd, yyyy h:mm tt")
                        –
                        @Model.Event.EndDateTime.ToString("h:mm tt")
                    </p>

                    <p class="text-gray-600 mb-2">
                        <i class="bi bi-geo-alt"></i>
                        Location: @Model.Event.Location
                    </p>

                    <p class="text-gray-600 mb-2">
                        Category: @Model.Event.Category?.Name
                    </p>

                    <p class="text-gray-600 mb-6">
                        Max Attendees: @Model.Event.MaxAttendees
                    </p>

                    <hr class="my-4">

                    <div class="text-gray-700 text-base leading-relaxed mb-6">
                        @Html.Raw(Model.Event.Description)
                    </div>

                    <div class="mt-auto">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <form method="post" class="space-y-4">
                                <input type="hidden" asp-for="EventId" value="@Model.Event.Id" />
                                <button type="submit"
                                        class="w-full bg-purple-600 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-lg transition duration-300">
                                    Book Your Spot
                                </button>

                                @if (!string.IsNullOrEmpty(Model.BookingMessage))
                                {
                                    <p class="text-green-600 font-semibold">@Model.BookingMessage</p>
                                }
                                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                                {
                                    <p class="text-red-600 font-semibold">@Model.ErrorMessage</p>
                                }
                            </form>
                        }
                        else
                        {
                            <p class="mb-4">
                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Page("/Events/Details", new { id = Model.Event.Id })"
                                   class="text-purple-600 hover:underline font-semibold">
                                    Log in
                                </a>
                                to book this event.
                            </p>
                        }

                        <a asp-page="./Index"
                           class="inline-block mt-4 bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-6 rounded-lg transition duration-300">
                            Back to Events
                        </a>
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="text-center bg-yellow-100 border border-yellow-300 p-6 rounded-lg shadow-md">
                <h2 class="text-xl font-bold text-yellow-700 mb-2">Event not found</h2>
                <p class="text-gray-600 mb-4">The event you are looking for does not exist.</p>
                <a asp-page="./Index"
                   class="inline-block bg-gray-200 hover:bg-gray-300 text-gray-800 font-semibold py-2 px-6 rounded-lg transition duration-300">
                    Back to Events
                </a>
            </div>
        }
    </div>
</section>
