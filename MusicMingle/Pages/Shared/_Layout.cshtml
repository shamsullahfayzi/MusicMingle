<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MusicMingle</title>

    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        /* Extra custom styles */
        .nav-link {
            position: relative;
            transition: color 0.3s ease;
        }

            .nav-link::after {
                content: '';
                position: absolute;
                left: 0;
                bottom: -4px;
                width: 0%;
                height: 2px;
                background-color: #8B5CF6; /* purple-500 */
                transition: width 0.3s ease;
            }

            .nav-link:hover::after {
                width: 100%;
            }

        input, textarea {
            border: 1px solid gray;
        }
    </style>
    @RenderSection("Style",false)
</head>

<body class="bg-gray-100 font-sans">

    <div class="min-h-screen flex flex-col">

        @if (User.IsInRole("Admin"))
        {
            <!-- Admin Layout -->
            <div class="flex flex-1">
                <aside class="w-64 bg-gray-900 text-gray-300 flex flex-col p-6 space-y-6">
                    <!-- Admin Sidebar Content -->
                    <div class="flex flex-col items-center space-y-2">
                        <div class="w-16 h-16 rounded-full bg-gray-700 flex items-center justify-center text-2xl">
                            <i class="fas fa-user"></i>
                        </div>
                        <div class="text-white font-semibold">@User.Identity.Name</div>
                        <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="w-full">
                            <button type="submit" class="mt-2 text-sm bg-purple-600 hover:bg-purple-700 text-white font-bold py-1.5 w-full rounded transition">
                                Logout
                            </button>
                        </form>
                    </div>

                    <div class="border-t border-gray-700 my-4"></div>

                    <nav class="flex flex-col space-y-4">
                        <a asp-page="/" class="flex items-center space-x-3 hover:text-white hover:bg-purple-600 p-2 rounded-md transition">
                            <i class="fas fa-home"></i><span>Dashboard</span>
                        </a>
                        <a asp-page="/Admin/Events/Index" class="flex items-center space-x-3 hover:text-white hover:bg-purple-600 p-2 rounded-md transition">
                            <i class="fas fa-calendar-alt"></i><span>Manage Events</span>
                        </a>
                        <a asp-page="/Admin/Categories/Index" class="flex items-center space-x-3 hover:text-white hover:bg-purple-600 p-2 rounded-md transition">
                            <i class="fas fa-tags"></i><span>Manage Categories</span>
                        </a>
                        <a asp-page="/Admin/Users/Index" class="flex items-center space-x-3 hover:text-white hover:bg-purple-600 p-2 rounded-md transition">
                            <i class="fas fa-users"></i><span>Manage Users</span>
                        </a>
                        <a asp-page="/Admin/Bookings/Index" class="flex items-center space-x-3 hover:text-white hover:bg-purple-600 p-2 rounded-md transition">
                            <i class="fas fa-chart-line"></i><span>Reports</span>
                        </a>
                        <a asp-area="Identity" asp-page="/Manage/PersonalData" class="flex items-center space-x-3 hover:text-white hover:bg-purple-600 p-2 rounded-md transition">
                            <i class="fas fa-cogs"></i><span>Settings</span>
                        </a>
                    </nav>

                    <div class="mt-auto text-xs text-gray-500 text-center">
                        &copy; @DateTime.Now.Year MusicMingle
                    </div>
                </aside>

                <div class="flex-1 flex flex-col">
                    <main class="flex-1 p-8">
                        @RenderBody()
                    </main>
                </div>
            </div>
        }
        else
        {
            <!-- User Layout with Frosted Glass Navbar -->
            <header class="bg-white/30 backdrop-blur-md shadow-md">
                <div class="max-w-7xl mx-auto px-4 py-4 flex justify-between items-center">
                    <div class="text-2xl font-bold text-purple-700">
                        <a href="/" class="nav-link ">  
                            
                        MusicMingle
                        </a>
                        </div>
                    <nav class="flex items-center space-x-8 text-gray-700">
                        <a asp-page="/Index" class="nav-link text-md font-semibold">Home</a>
                        <a asp-page="/Events/Index" class="nav-link text-md font-semibold">Explore</a>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <a asp-page="/Bookings/MyBookings" class="nav-link text-md font-semibold">My Bookings</a>

                            <a asp-area="Identity" asp-page="/Account/Manage/Index" class="nav-link text-md font-semibold">Profile</a>

                            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="inline">
                                <button type="submit" class="nav-link text-md font-semibold">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a asp-area="Identity" asp-page="/Account/Login" class="nav-link text-md font-semibold">Login</a>
                            <a asp-area="Identity" asp-page="/Account/Register" class="nav-link text-md font-semibold">Register</a>
                        }
                        <a asp-page="/Contact" class="nav-link text-md font-semibold">Contact</a>

                    </nav>
                </div>
            </header>

            <main class="flex-1 p-8">
                @RenderBody()
            </main>
        }

        <footer class="bg-gray-800 text-gray-400 text-center p-4">
            &copy; @DateTime.Now.Year - MusicMingle
        </footer>

    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
