@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager

<ul class="flex flex-col md:flex-row space-y-2 md:space-y-0 md:space-x-4 items-center">
@if (SignInManager.IsSignedIn(User))
{
    <li class="text-gray-700 dark:text-gray-300">
        <span>Hello @User.Identity?.Name!</span>
    </li>
    <li>
        <form class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
            <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white font-medium py-2 px-4 rounded transition duration-300 ease-in-out">Logout</button>
        </form>
    </li>
}
else
{
    <li>
        <a class="bg-purple-600 hover:bg-purple-700 text-white font-medium py-2 px-4 rounded transition duration-300 ease-in-out" asp-area="Identity" asp-page="/Account/Register">Register</a>
    </li>
    <li>
        <a class="bg-transparent hover:bg-purple-600 text-purple-600 hover:text-white font-medium py-2 px-4 rounded border border-purple-600 hover:border-transparent transition duration-300 ease-in-out" asp-area="Identity" asp-page="/Account/Login">Login</a>
    </li>
}
</ul>
