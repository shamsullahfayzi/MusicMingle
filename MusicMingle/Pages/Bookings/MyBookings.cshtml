@page
@model MusicMingle.Pages.Bookings.MyBookingsModel
@{
    ViewData["Title"] = "My Bookings";
}

<section class="py-12 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-bold mb-10 text-center text-gray-800">@ViewData["Title"]</h1>

        @if (Model.Bookings.Any())
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var booking in Model.Bookings)
                {
                    <div class="bg-white rounded-xl shadow-md border border-gray-200 flex flex-col hover:shadow-lg transition duration-300">
                        @if (booking.Event != null)
                        {
                            @if (!string.IsNullOrEmpty(booking.Event.ThumbnailImagePath))
                            {
                                <a asp-page="/Events/Details" asp-route-id="@booking.EventId" class="block overflow-hidden rounded-t-xl">
                                    <img src="@Url.Content(booking.Event.ThumbnailImagePath)" alt="@booking.Event.Title" class="w-full h-48 object-cover hover:scale-105 transition-transform duration-300">
                                </a>
                            }

                            <div class="p-6 flex flex-col flex-grow">
                                <h3 class="text-lg font-bold text-purple-700 mb-2">
                                    <a asp-page="/Events/Details" asp-route-id="@booking.EventId" class="hover:underline">
                                        @booking.Event.Title
                                    </a>
                                </h3>

                                <div class="text-gray-600 text-sm mb-1">
                                    <i class="bi bi-calendar-event"></i> @booking.Event.StartDateTime.ToString("MMMM dd, yyyy h:mm tt")
                                </div>

                                <div class="text-gray-600 text-sm mb-3">
                                    <i class="bi bi-geo-alt"></i> @booking.Event.Location
                                </div>

                                <div class="text-sm font-medium text-gray-700 mb-4">
                                    Category: <span class="text-gray-900">@booking.Event.Category?.Name</span>
                                </div>

                                <p class="text-xs text-gray-400 mt-auto mb-4">
                                    Booked on: @booking.BookingDate.ToString("yyyy-MM-dd")
                                </p>

                                <div class="mt-auto">
                                    <a asp-page="/Events/Details" asp-route-id="@booking.EventId"
                                       class="inline-block w-full text-center bg-purple-600 hover:bg-purple-700 text-white font-semibold py-2 rounded-lg transition duration-300 text-sm">
                                        View Details
                                    </a>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="p-6 flex items-center justify-center h-full text-center">
                                <p class="text-red-500 font-semibold">Error: Event not found.</p>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="bg-white p-10 rounded-xl shadow-md text-center max-w-xl mx-auto border border-gray-200">
                <h2 class="text-2xl font-semibold text-gray-700 mb-4">No Bookings Yet</h2>
                <p class="text-gray-500 mb-6">You haven't booked any events yet. Find one that excites you!</p>

                <a asp-page="/Events/Index"
                   class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg transition duration-300">
                    Browse Events
                </a>
            </div>
        }
    </div>
</section>
