@page
@model MusicMingle.Pages.Admin.Bookings.IndexModel
@{
    ViewData["Title"] = "Manage Bookings";
}

@{
    var attendeeCounts = Model.Bookings
        .GroupBy(b => b.EventId)
        .ToDictionary(g => g.Key, g => g.Count());
}

<section class="py-12 bg-gray-50 min-h-screen">
    <div class="container mx-auto px-4">
        <h1 class="text-3xl md:text-4xl font-bold mb-10 text-center text-gray-800">Manage Bookings</h1>

        @if (Model.Bookings.Any())
        {
            <div class="overflow-x-auto shadow-md rounded-lg">
                <table class="min-w-full bg-white rounded-lg overflow-hidden">
                    <thead class="bg-purple-600 text-white">
                        <tr>
                            <th class="px-6 py-4 text-left text-sm font-semibold">Event</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold">Email</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold">Booking Date</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold">Event Price</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold">Max Attendees</th>
                            <th class="px-6 py-4 text-left text-sm font-semibold">Current Bookings</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700">
                        @foreach (var booking in Model.Bookings)
                        {
                            <tr class="border-b hover:bg-gray-50 transition duration-200">
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @(booking.Event?.Title ?? "N/A")
                                </td>
                                
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @(booking.User?.Email ?? "N/A")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @(booking.BookingDate.ToString("yyyy-MM-dd"))
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (booking.Event != null)
                                    {
                                        <span>$@booking.Event.Price.ToString("0.00")</span>
                                    }
                                    else
                                    {
                                        <span class="text-gray-400">Free</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @(booking.Event?.MaxAttendees != null ? booking.Event?.MaxAttendees : "N/A")
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @(attendeeCounts.TryGetValue(booking.EventId, out var count) ? count : 0)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="bg-white p-10 rounded-xl shadow-md text-center max-w-xl mx-auto">
                <h2 class="text-2xl font-semibold text-gray-700 mb-4">No Bookings Found</h2>
                <p class="text-gray-500">There are currently no bookings to display.</p>
            </div>
        }
    </div>
</section>
