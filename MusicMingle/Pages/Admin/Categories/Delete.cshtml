@page "{id:int}"
@model MusicMingle.Pages.Admin.Categories.DeleteModel

@{
    ViewData["Title"] = "Delete Category";
}

<h1 class="text-2xl font-bold mb-6 text-gray-800">Delete Category</h1>

<div class="bg-white p-8 shadow rounded-lg max-w-xl mx-auto space-y-6">
    <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded">
        <p class="text-red-800 font-semibold">Are you sure you want to delete this category?</p>
        <p class="text-red-700 text-sm mt-2">
            Deleting this category will also remove all associated events. This action cannot be undone.
        </p>
    </div>

    <div>
        <p class="text-gray-600 text-sm">Category Name</p>
        <p class="font-semibold text-gray-800">@Model.Category.Name</p>
    </div>

    <form method="post" class="flex space-x-4 pt-4">
        <input type="hidden" asp-for="Category.Id" />

        <button type="submit" class="btn btn-danger">Confirm Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
