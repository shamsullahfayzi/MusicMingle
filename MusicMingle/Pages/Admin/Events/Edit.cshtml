@page "{id:int}"
@model MusicMingle.Pages.Admin.Events.EditModel

@{
    ViewData["Title"] = "Edit Event";
}

<h1 class="text-2xl font-bold mb-6 text-gray-800">Edit Event</h1>

<div class="bg-white p-8 shadow-lg rounded-lg max-w-3xl mx-auto">
    <form method="post" enctype="multipart/form-data" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-red-500 text-sm mb-4"></div>
        <input type="hidden" asp-for="Event.Id" />
        <input type="hidden" asp-for="Event.ThumbnailImagePath" />

        <div>
            <label asp-for="Event.Title" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Event.Title" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-purple-500 focus:border-purple-500" />
            <span asp-validation-for="Event.Title" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Event.Description" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <textarea asp-for="Event.Description" rows="4" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-purple-500 focus:border-purple-500"></textarea>
            <span asp-validation-for="Event.Description" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Event.Location" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Event.Location" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-purple-500 focus:border-purple-500" />
            <span asp-validation-for="Event.Location" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Event.StartDateTime" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Event.StartDateTime" type="datetime-local" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-purple-500 focus:border-purple-500" />
            <span asp-validation-for="Event.StartDateTime" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Event.EndDateTime" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Event.EndDateTime" type="datetime-local" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-purple-500 focus:border-purple-500" />
            <span asp-validation-for="Event.EndDateTime" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Event.MaxAttendees" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Event.MaxAttendees" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-purple-500 focus:border-purple-500" />
            <span asp-validation-for="Event.MaxAttendees" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Event.Price" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <input asp-for="Event.Price" type="number" step="0.01" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-purple-500 focus:border-purple-500" />
            <span asp-validation-for="Event.Price" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="Event.CategoryId" class="block text-sm font-medium text-gray-700 mb-1"></label>
            <select asp-for="Event.CategoryId" asp-items="Model.CategorySelectList" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-purple-500 focus:border-purple-500">
            </select>
            <span asp-validation-for="Event.CategoryId" class="text-red-500 text-sm"></span>
        </div>

        <div>
            <label asp-for="ThumbnailImage" class="block text-sm font-medium text-gray-700 mb-1">New Thumbnail Image (Optional)</label>
            <input asp-for="ThumbnailImage" type="file" class="w-full rounded-md border-gray-300 shadow-sm focus:ring-purple-500 focus:border-purple-500" />
            <span asp-validation-for="ThumbnailImage" class="text-red-500 text-sm"></span>

            @if (!string.IsNullOrEmpty(Model.Event.ThumbnailImagePath))
            {
                <div class="mt-4">
                    <label class="text-sm text-gray-500">Current Thumbnail:</label>
                    <img src="@Model.Event.ThumbnailImagePath" alt="Current Thumbnail" class="mt-2 max-w-xs rounded-lg border" />
                </div>
            }
        </div>

        <div class="flex space-x-4">
            <input type="submit" value="Save Changes" class="px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-md text-sm font-semibold transition" />
            <a asp-page="Index" class="px-5 py-2 bg-gray-300 hover:bg-gray-400 text-gray-800 rounded-md text-sm font-semibold transition">
                Back to List
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
