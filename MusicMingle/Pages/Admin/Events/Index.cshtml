@page
@model MusicMingle.Pages.Admin.Events.IndexModel

@{
    ViewData["Title"] = "Manage Events";
}

<h1 class="text-2xl font-bold mb-6 text-gray-800">Manage Events</h1>

<div class="mb-6">
    <a asp-page="Create"
       class="inline-block px-5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-md text-sm font-semibold transition">
        + Create New Event
    </a>
</div>

<div class="overflow-x-auto bg-white shadow-md rounded-lg">
    <table class="min-w-full table-auto">
        <thead class="bg-gray-100 text-gray-700 text-sm uppercase">
            <tr>
                <th class="px-6 py-3 text-left">Title</th>
                <th class="px-6 py-3 text-left">Category</th>
                <th class="px-6 py-3 text-left">Start Date & Time</th>
                <th class="px-6 py-3 text-left">Location</th>
                <th class="px-6 py-3 text-left">Price</th>
                <th class="px-6 py-3"></th>
            </tr>
        </thead>
        <tbody class="text-gray-700 text-sm divide-y divide-gray-200">
            @foreach (var item in Model.Events)
            {
                <tr class="hover:bg-gray-50">
                    <td class="px-6 py-4">
                        @Html.DisplayFor(modelItem => item.Title)
                    </td>
                    <td class="px-6 py-4">
                        @Html.DisplayFor(modelItem => item.Category!.Name)
                    </td>
                    <td class="px-6 py-4">
                        @Html.DisplayFor(modelItem => item.StartDateTime)
                    </td>
                    <td class="px-6 py-4">
                        @Html.DisplayFor(modelItem => item.Location)
                    </td>
                    <td class="px-6 py-4">
                        $@Html.DisplayFor(modelItem => item.Price)
                    </td>
                    <td class="px-6 py-4 text-right space-x-2">
                        <a asp-page="Edit" asp-route-id="@item.Id"
                           class="text-purple-600 hover:text-purple-800 font-semibold text-sm">
                            Edit
                        </a>
                        <a asp-page="Details" asp-route-id="@item.Id"
                           class="text-blue-600 hover:text-blue-800 font-semibold text-sm">
                            Details
                        </a>
                        <a asp-page="Delete" asp-route-id="@item.Id"
                           class="text-red-600 hover:text-red-800 font-semibold text-sm">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
